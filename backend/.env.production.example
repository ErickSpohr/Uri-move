APP_NAME="URI Move"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=
PORT=8080
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=pgsql
# Supabase: Connect -> Session pooler (port 5432).
# postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres
# Set the real URL only in the hosting provider's secret environment variables.
DB_URL=
DB_SSLMODE=require
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public
# Set true only when applying migrations to the intended hosted database.
RUN_MIGRATIONS=false
# Brevo HTTPS API works on Render's free plan.
MAIL_MAILER=brevo
BREVO_API_KEY=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="URI Move"
